{
  "extends": "./node_modules/expo/tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "jsx": "react-native",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "paths": {
      "@/constants/*": [
        "./components/constants/*"
      ],
      "@/data/*": [
        "./components/data/*"
      ],
      "@/store/*": [
        "./components/store/*"
      ],
      "@/types": [
        "./components/types"
      ],
      "@/types/*": [
        "./components/types/*"
      ],
      "@/*": [
        "./*",
        "./components/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
